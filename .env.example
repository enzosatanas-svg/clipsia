# =========================================
# ClipAI Generator - Environment Variables
# =========================================

# --- Whisper Model ---
# Options: tiny, base, small, medium, large
# 'small' is a good balance of speed vs accuracy
WHISPER_MODEL=small

# --- LLM for Viral Detection ---
# Leave OPENAI_API_KEY blank to use the FREE local fallback (rule-based)
OPENAI_API_KEY=

# --- YouTube Data API v3 (for publishing to YouTube Shorts) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- TikTok API (for publishing to TikTok) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Instagram Graph API (for publishing to Instagram Reels) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- App Settings ---
OUTPUT_DIR=output
DOWNLOADS_DIR=downloads
MAX_VIRAL_CLIPS=3
